# Copy to .env and adjust. Every value here is optional for a local demo.

# Seed a demo account (demo / demo-password), a sample opening and fictional resumes on startup.
DEMO_MODE=true

# JWT signing key. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a random key is generated on each start and users must log in again after restarts.
SECRET_KEY=

# Screening provider: anthropic (default), openai, or mock.
# If the selected provider has no API key, the app falls back to the offline mock scorer.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SQLite by default; any SQLAlchemy URL works.
DATABASE_URL=sqlite:///./data/agent_finder.db

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend (baked in at build time): where the browser reaches the API.
VITE_API_BASE_URL=http://localhost:8000
